# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ruby portatil embebido (lo baja scripts/setup-ruby.ps1) y la copia de
# edit_rxdata.rb/driver que genera build.rs en cada build - nunca se comitean.
# build.rs crea resources/ruby/ si falta (Tauri valida que exista incluso para
# `cargo check`), asi que ya no hace falta versionar un .gitkeep.
src-tauri/resources/ruby/*
!src-tauri/resources/ruby/.gitkeep
src-tauri/resources/rxdata/

# backups con fecha que genera save_document() al probar contra test_saves/
*.bak

# Capturas de las pruebas e2e (Playwright) y resultados
e2e/screenshots/
test-results/
playwright-report/

# Salida del empaquetado del release (scripts/package-release.mjs)
release-out/
*.zip
