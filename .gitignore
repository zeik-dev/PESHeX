# Ruby portatil embebido (lo baja scripts/setup-ruby.ps1) y la copia de
# edit_rxdata.rb/driver que genera build.rs en cada build - nunca se comitean.
# El directorio resources/ruby/ en si se versiona vacio (.gitkeep) porque
# Tauri valida que exista incluso para `cargo check`.
src-tauri/resources/ruby/*
!src-tauri/resources/ruby/.gitkeep
src-tauri/resources/rxdata/

